{
  "name": "parking-pos",
  "version": "1.0.0",
  "private": true,
  "author": "Theerapath Chaicharoen",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "electron": "electron .",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "dist": "npm run build && electron-builder",
    "dist:clean": "rmdir /s /q dist & npm run dist"
  },
  "build": {
    "appId": "com.parking.pos",
    "productName": "Parking POS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app/.next/standalone",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "app/.next/standalone/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "app/.next/standalone/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "app/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "database",
        "to": "database"
      }
    ],
    "asarUnpack": [
      "**/.prisma/**",
      "resources/app/.next/**"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^16.2.6",
    "react": "19.2.4",
    "react-barcode": "^1.6.1",
    "react-dom": "19.2.4",
    "react-to-print": "^3.3.0",
    "sweetalert2": "^11.26.24",
    "wait-on": "^9.0.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}